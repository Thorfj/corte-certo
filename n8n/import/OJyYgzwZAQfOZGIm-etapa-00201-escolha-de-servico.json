    {
      "id": "04d3938e-3493-4fd1-bd8a-8679f24f0624",
      "name": "Monta menu e valida escolha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e = $('Entrada da etapa').first().json;\nconst s = e.sessao || {};\nconst servicos = $input.all().map(i => i.json).filter(x => x.id);\nconst aguardando = Boolean(s.aguardando_resposta);\nconst menu = servicos.map((x, i) => (i + 1) + '. ' + x.nome + ' — R$ ' + Number(x.preco || 0).toFixed(2).replace('.', ',')).join('\\n');\n\n// Saudação com o primeiro nome (\"meu nome é ana trentin\" -> \"Ana\")\nconst primeiroNome = String(e.nome_cliente || '')\n  .trim()\n  .replace(/^(oi|olá|ola)[,!.\\s]+/i, '')\n  .replace(/^(meu nome é|meu nome e|me chamo|aqui é|aqui e|sou o|sou a|sou|é o|é a)\\s+/i, '')\n  .split(/\\s+/)[0]\n  .replace(/[^\\p{L}'-]/gu, '');\nconst nomeBonito = primeiroNome ? primeiroNome.charAt(0).toUpperCase() + primeiroNome.slice(1).toLowerCase() : '';\nconst saudacao = !nomeBonito ? '' : e.nome_recem_informado ? 'Prazer, ' + nomeBonito + '! 😊' : 'Oi, ' + nomeBonito + '! 👋 Que bom te ver de novo.';\n\nlet valido = false;\nlet selecionados = [];\nif (aguardando) {\n  const texto = String(e.mensagem_texto || '').trim();\n  const numeros = (texto.match(/\\d+/g) || []).map(n => parseInt(n, 10));\n  if (numeros.length > 0 && numeros.every(n => n >= 1 && n <= servicos.length)) {\n    selecionados = [...new Set(numeros)].map(n => servicos[n - 1]);\n    valido = true;\n  }\n}\n\nreturn [{ json: { aguardando, valido, menu, saudacao, selecionados_ids: selecionados.map(x => x.id) } }];"
      }
    },
