    {
      "id": "be5fc964-0557-44eb-8b0c-f26803dbf245",
      "name": "Decide o que fazer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepara pedido').first().json;\nconst r = $input.first().json;\nconst existe = r.statusCode !== 404;\n// open = conectado | connecting = esperando ler o QR | close = desconectado\nconst estado = existe ? ((r.body && r.body.instance && r.body.instance.state) || 'close') : 'inexistente';\nlet rota = 'responder';\nif (ctx.acao === 'conectar' && estado !== 'open') rota = existe ? 'qr' : 'criar';\nif (ctx.acao === 'desconectar' && existe) rota = 'desconectar';\nreturn [{ json: { ...ctx, estado, rota } }];"
      }
    },
