        "responseBody": "={{ (() => { const ctx = $(\"Decide o que fazer\").first().json; const lista = Array.isArray($json.body) ? $json.body : []; const i = lista.find(x => (x.name || x.instanceName || (x.instance && x.instance.instanceName)) === ctx.instancia) || lista[0] || {}; const dono = i.ownerJid || i.owner || (i.instance && i.instance.owner) || \"\"; const nome = i.profileName || (i.instance && i.instance.profileName) || null; return JSON.stringify({ estado: ctx.estado, instancia: ctx.instancia, numero: ctx.estado === \"open\" ? String(dono).split(\"@\")[0] || null : null, nome: ctx.estado === \"open\" ? nome : null }); })() }}",
