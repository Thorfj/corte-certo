        1100,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A instância da prospecção é fixa (nunca vem do navegador) e é a mesma usada pela Safra de prospecção\nconst pedido = ($('Webhook - WhatsApp da prospecção').first().json.body || {}).acao;\nconst acao = ['status', 'conectar', 'desconectar'].includes(pedido) ? pedido : 'status';\nreturn [{ json: { acao, instancia: 'prospeccao' } }];"
      }
    },
