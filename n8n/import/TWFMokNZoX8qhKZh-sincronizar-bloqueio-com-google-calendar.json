    {
      "id": "7432d3eb-6fd3-4087-9913-4ee5c1c9b4f7",
      "name": "Monta eventos por calendário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        -140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ZONA = 'America/Sao_Paulo';\nconst b = $('Analisa mudança').first().json.bloqueio;\n// Profissional sem agenda própria usa a agenda principal da conta Google da barbearia\nconst calendarios = [...new Set($input.all().map(i => i.json.agendas || 'primary'))];\nconst hora = (h) => String(h).length === 5 ? h + ':00' : String(h);\nconst BYDAY = ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'];\nconst temHorario = Boolean(b.horario_inicio && b.horario_fim);\nconst somaDias = (iso, dias) => DateTime.fromISO(iso, { zone: ZONA }).plus({ days: dias }).toFormat('yyyy-MM-dd');\n\nconst evento = {\n  summary: b.motivo ? 'Bloqueado — ' + b.motivo : 'Bloqueado',\n  description: 'Criado automaticamente pelo Barbozap',\n  extendedProperties: { private: { corte_certo_bloqueio_id: String(b.id) } }\n};\n\nlet dataBase = b.data_inicio;\nif (b.tipo === 'recorrente') {\n  const hoje = DateTime.now().setZone(ZONA).startOf('day');\n  const alvo = Number(b.dia_semana) === 0 ? 7 : Number(b.dia_semana);\n  dataBase = hoje.plus({ days: (alvo - hoje.weekday + 7) % 7 }).toFormat('yyyy-MM-dd');\n}\n\nif (temHorario) {\n  evento.start = { dateTime: dataBase + 'T' + hora(b.horario_inicio), timeZone: ZONA };\n  evento.end = { dateTime: dataBase + 'T' + hora(b.horario_fim), timeZone: ZONA };\n} else {\n  evento.start = { date: dataBase };\n  evento.end = { date: somaDias(b.tipo === 'periodo' ? b.data_fim : dataBase, 1) };\n}\nif (b.tipo === 'periodo' && temHorario) evento.recurrence = ['RRULE:FREQ=DAILY;UNTIL=' + String(b.data_fim).replace(/-/g, '') + 'T235959Z'];\nif (b.tipo === 'recorrente') evento.recurrence = ['RRULE:FREQ=WEEKLY;BYDAY=' + BYDAY[Number(b.dia_semana)]];\n\nreturn calendarios.map(calendarId => ({ json: { calendarId, evento } }));"
      }
    },
