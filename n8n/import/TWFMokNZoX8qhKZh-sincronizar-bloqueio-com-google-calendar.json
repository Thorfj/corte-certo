        "jsCode": "const mapa = {};\nconst eventos = $('Monta eventos por calendário').all();\n$input.all().forEach((item, i) => {\n  if (item.json && item.json.id && eventos[i]) mapa[eventos[i].json.calendarId] = item.json.id;\n});\nreturn [{ json: { google_event_ids: mapa } }];"
      }
