      "name": "Analisa mudança",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || {};\nconst rec = b.record || null;\nconst old = b.old_record || null;\n\n// Bloqueios que vieram do próprio Google não voltam para o Google. UPDATE é ignorado\n// (o n8n grava google_event_ids depois de criar os eventos).\nif (b.type === 'INSERT' && rec && rec.origem !== 'google_calendar') {\n  return [{ json: { acao: 'criar', barbearia_id: rec.barbearia_id, bloqueio: rec, lista: [] } }];\n}\nif (b.type === 'DELETE' && old && old.origem !== 'google_calendar') {\n  const lista = Object.entries(old.google_event_ids || {}).map(([calendarId, eventId]) => ({ calendarId, eventId }));\n  if (lista.length) return [{ json: { acao: 'apagar', barbearia_id: old.barbearia_id, bloqueio: old, lista } }];\n}\nreturn [];"
      }
    },
