            {
              "id": "numero",
              "name": "numero",
              "value": "={{ (() => { const d = String($json.numero || \"\").replace(/\\D/g, \"\"); return (d.length === 10 || d.length === 11) ? \"55\" + d : d; })() }}",
              "type": "string"
            },
            {
              "id": "texto",
              "name": "texto",
              "value": "={{ $json.texto || \"\" }}",
              "type": "string"
            }
          ]
        }
      }
