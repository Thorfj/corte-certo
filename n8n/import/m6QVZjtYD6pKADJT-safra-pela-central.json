    {
      "id": "5081e4d9-e112-4eb2-b4c0-3ee129d65f1f",
      "name": "Monta safra",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// O texto vem da prévia da Central (pode ter sido editado); etapa e próximo passo vêm do roteiro no banco\nconst pedido = $('Lê o pedido').first().json;\nconst leads = new Map($('Busca leads da safra').all().map(i => i.json).filter(l => l && l.id).map(l => [l.id, l]));\nconst roteiros = new Map($input.all().map(i => i.json).filter(r => r && r.id).map(r => [Number(r.id), r]));\nconst etapas = ['novo_lead', 'contato_feito', 'respondeu', 'demo_agendada', 'teste_gratis', 'fechado_ganho', 'perdido'];\nconst somaDias = (n) => DateTime.now().setZone('America/Sao_Paulo').plus({ days: n }).toISODate();\nconst itens = [];\nconst ignorados = [];\npedido.itens.forEach(p => {\n  const lead = leads.get(p.lead_id);\n  if (!lead) { ignorados.push({ lead_id: p.lead_id, motivo: 'lead não encontrado' }); return; }\n  if (!['novo_lead', 'contato_feito'].includes(lead.status)) { ignorados.push({ nome: lead.nome_barbearia, motivo: 'etapa não é Novo nem Contatado' }); return; }\n  if (lead.proximo_passo === 'Na fila do n8n') { ignorados.push({ nome: lead.nome_barbearia, motivo: 'já está em outra safra' }); return; }\n  if (!lead.telefone) { ignorados.push({ nome: lead.nome_barbearia, motivo: 'sem telefone' }); return; }\n  const r = roteiros.get(p.roteiro_id) || null;\n  const update = {};\n  if (r && r.status_depois && etapas.indexOf(r.status_depois) > etapas.indexOf(lead.status)) update.status = r.status_depois;\n  if (r && r.dias_proximo_passo !== null && r.dias_proximo_passo !== undefined) {\n    update.proximo_passo = r.proximo_passo;\n    update.data_proximo_passo = somaDias(r.dias_proximo_passo);\n  }\n  itens.push({\n    id: lead.id, nome: lead.nome_barbearia, bairro: lead.bairro, telefone: lead.telefone,\n    tipo_telefone: lead.tipo_telefone, ultimo_contato: lead.ultimo_contato,\n    proximo_original: lead.proximo_passo, data_original: lead.data_proximo_passo,\n    roteiro: r ? r.etapa : 'Mensagem livre', texto: p.texto, update\n  });\n});\nreturn [{ json: { total: itens.length, leads: itens, ignorados } }];"
      }
    },
