    {
      "id": "e0824645-1766-4c5a-ab45-02dbda43305f",
      "name": "Lê o pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Webhook - Safra pela Central').first().json.body || {};\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst vistos = new Set();\nconst itens = (Array.isArray(body.itens) ? body.itens : []).filter(i => {\n  if (!i || !uuid.test(String(i.lead_id)) || vistos.has(i.lead_id)) return false;\n  vistos.add(i.lead_id);\n  return true;\n}).map(i => ({ lead_id: String(i.lead_id), roteiro_id: Number(i.roteiro_id) || null, texto: String(i.texto || '').trim().slice(0, 1500) }));\nlet erro = null;\nif (!itens.length) erro = 'Nenhum lead válido na safra.';\nelse if (itens.length > 30) erro = 'No máximo 30 leads por safra.';\nelse if (itens.some(i => !i.texto)) erro = 'Tem lead sem mensagem na safra.';\nconst meuNome = String($('Busca na equipe interna').first().json.nome || '').split(' ')[0];\nreturn [{ json: { ok: !erro, erro, itens, meuNome } }];"
      }
    },
