    {
      "id": "3ff73a84-ad6a-4ae5-8c59-b996b5fdf49a",
      "name": "Lista eventos do Google (14 dias)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/calendar/v3/calendars/{{ encodeURIComponent($('Lista profissionais').item.json.agendas) }}/events?singleEvents=true&maxResults=250&timeMin={{ encodeURIComponent($now.toISO()) }}&timeMax={{ encodeURIComponent($now.plus({ days: 14 }).toISO()) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "b16a5348-5bab-4458-a571-2b56eedf9332",
      "name": "Calcula ações de sincronização",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ZONA = 'America/Sao_Paulo';\nconst prof = $('Lista profissionais').item.json;\nif ($json.error || !Array.isArray($json.items)) return { json: { acoes: [] } };\n\nconst hoje = DateTime.now().setZone(ZONA).startOf('day');\nconst limite = hoje.plus({ days: 14 });\nconst atends = $('Busca atendimentos sincronizados').all().map(i => i.json).filter(a => a.id);\nconst bloqs = $('Busca bloqueios vindos do Google').all().map(i => i.json)\n  .filter(b => b.id && String(b.barbearia_id) === String(prof.barbearia_id) && String(b.id_prof) === String(prof.id));\nconst local = (dt) => DateTime.fromISO(dt, { setZone: true }).setZone(ZONA);\n\nconst acoes = [];\nconst idsVistos = new Set();\n\nfor (const ev of $json.items) {\n  if (ev.status === 'cancelled' || ev.transparency === 'transparent') continue;\n  const priv = (ev.extendedProperties && ev.extendedProperties.private) || {};\n  idsVistos.add(ev.id);\n\n  // Evento criado pelo próprio Barbozap a partir de um bloqueio: nada a fazer\n  if (priv.corte_certo_bloqueio_id) continue;\n\n  // Evento de atendimento: se alguém mexeu no Google, o Google manda\n  if (priv.corte_certo_atendimento_id) {\n    const at = atends.find(a => String(a.id) === String(priv.corte_certo_atendimento_id));\n    if (!at || !ev.start || !ev.start.dateTime || !ev.end || !ev.end.dateTime) continue;\n    const ini = local(ev.start.dateTime);\n    const dur = Math.round(local(ev.end.dateTime).diff(ini, 'minutes').minutes);\n    const data = ini.toFormat('yyyy-MM-dd');\n    const horario = ini.toFormat('HH:mm');\n    if (data !== at.data_agend || horario !== String(at.horario).slice(0, 5) || dur !== Number(at.duracao_atend)) {\n      acoes.push({ tipo: 'atualizar_atendimento', id: at.id, body: { data_agend: data, horario: horario + ':00', duracao_atend: dur } });\n    }\n    continue;\n  }\n\n  // Evento manual: vira bloqueio no CRM (do profissional, ou da barbearia toda se for a agenda principal)\n  const jaExiste = bloqs.some(b => Object.values(b.google_event_ids || {}).includes(ev.id));\n  if (jaExiste) continue;\n\n  const body = { barbearia_id: prof.barbearia_id, id_prof: prof.id, motivo: ev.summary || 'Bloqueio manual no Google Calendar', origem: 'google_calendar', google_event_ids: { [prof.agendas]: ev.id } };\n  if (ev.start && ev.start.dateTime) {\n    const ini = local(ev.start.dateTime);\n    const fim = local(ev.end.dateTime);\n    Object.assign(body, { tipo: 'unico', data_inicio: ini.toFormat('yyyy-MM-dd'), horario_inicio: ini.toFormat('HH:mm'), horario_fim: fim.toFormat('HH:mm') });\n  } else if (ev.start && ev.start.date) {\n    const ultimoDia = DateTime.fromISO(ev.end.date, { zone: ZONA }).minus({ days: 1 }).toFormat('yyyy-MM-dd');\n    if (ultimoDia > ev.start.date) Object.assign(body, { tipo: 'periodo', data_inicio: ev.start.date, data_fim: ultimoDia });\n    else Object.assign(body, { tipo: 'unico', data_inicio: ev.start.date });\n  } else continue;\n  acoes.push({ tipo: 'criar_bloqueio', body });\n}\n\n// Bloqueios importados cujo evento sumiu do Google (só dentro da janela consultada)\nfor (const b of bloqs) {\n  const eventId = Object.values(b.google_event_ids || {})[0];\n  const dia = b.data_inicio ? DateTime.fromISO(b.data_inicio, { zone: ZONA }) : null;\n  if (eventId && !idsVistos.has(eventId) && dia && dia >= hoje && dia < limite) acoes.push({ tipo: 'apagar_bloqueio', id: b.id });\n}\n\nreturn { json: { acoes } };"
      }
    },
