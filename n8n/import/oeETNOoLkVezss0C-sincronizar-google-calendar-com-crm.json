    {
      "id": "cd015feb-4eac-40f9-b676-dc62a74c830e",
      "name": "Lista profissionais",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Uma leitura da agenda principal de cada barbearia conectada (bloqueio vale para a barbearia toda)\n// e uma para cada profissional que tem agenda própria.\nconst barbs = $('Busca barbearias conectadas').all().map(i => i.json).filter(b => b.id);\nconst profs = $('Busca profissionais com agenda').all().map(i => i.json).filter(p => p.id && p.agendas);\nconst itens = barbs.map(b => ({ json: { id: null, barbearia_id: b.id, agendas: 'primary' } }));\nfor (const p of profs) itens.push({ json: { id: p.id, barbearia_id: p.barbearia_id, agendas: p.agendas } });\nreturn itens;"
      }
    },
