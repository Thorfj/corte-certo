    {
      "id": "eac9dc0f-1fe5-4e76-ad75-24663a942799",
      "name": "Extrai e-mail do id_token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let email = null;\ntry {\n  const parte = String($json.id_token || '').split('.')[1].replace(/-/g, '+').replace(/_/g, '/');\n  const texto = typeof Buffer !== 'undefined' ? Buffer.from(parte, 'base64').toString('utf8') : atob(parte);\n  email = JSON.parse(texto).email || null;\n} catch (e) {}\n\nreturn { json: {\n  email,\n  access_token: $json.access_token,\n  refresh_token: $json.refresh_token,\n  expires_at: new Date(Date.now() + (Number($json.expires_in) || 3600) * 1000).toISOString()\n} };"
      }
    },
