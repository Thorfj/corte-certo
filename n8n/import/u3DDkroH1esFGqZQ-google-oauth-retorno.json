          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ barbearia_id: $('Lê parâmetros do retorno').first().json.barbearia_id, access_token: $json.access_token, refresh_token: $json.refresh_token || undefined, expires_at: $json.expires_at }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
