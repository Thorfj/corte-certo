      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.barbozap.com.br/instance/connectionState/{{ encodeURIComponent($json.instancia) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
