    {
      "id": "7b5f3210-74f5-4e1e-bd70-0257a756c6e3",
      "name": "Prepara pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// O nome da instância na Evolution é sempre o WhatsApp da barbearia (vem do banco, nunca do navegador)\nconst p = $input.first().json;\nconst pedido = ($('Webhook - Conexão WhatsApp').first().json.body || {}).acao;\nconst acao = ['status', 'conectar', 'desconectar'].includes(pedido) ? pedido : 'status';\nreturn [{ json: { acao, barbearia_id: p.barbearia_id, instancia: p.barbearias.whatsapp_barbearia } }];"
      }
    },
