    {
      "id": "bbec97e7-6290-4e66-b48f-7a6cedb60a4a",
      "name": "Decide o que fazer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepara pedido').first().json;\nconst r = $input.first().json;\nconst existe = r.statusCode !== 404;\n// open = conectado | connecting = esperando ler o QR | close = desconectado\nconst estado = existe ? ((r.body && r.body.instance && r.body.instance.state) || 'close') : 'inexistente';\nlet rota = 'responder';\nif (ctx.acao === 'conectar' && estado !== 'open') rota = existe ? 'qr' : 'criar';\nif (ctx.acao === 'desconectar' && existe && estado !== 'close') rota = 'desconectar';\nreturn [{ json: { ...ctx, estado, rota } }];"
      }
    },
