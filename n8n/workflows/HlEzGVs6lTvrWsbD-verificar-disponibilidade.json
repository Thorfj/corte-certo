    {
      "id": "e35cdd25-7be5-4f2e-8fa7-fe0fc0ff8566",
      "name": "Resultado final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $('Confere bloqueios e conflitos').first().json;\nconst ignorar = Number($('Recebe horário a verificar').first().json.ignorar_atend_id) || 0;\nlet ocupadoGoogle = false;\ntry {\n  const r = $('Consulta Google - eventos').first();\n  const eventos = (r && r.json && r.json.items) || [];\n  // Ignora eventos cancelados, marcados como \"livre\" e o evento do próprio atendimento que está sendo remarcado\n  ocupadoGoogle = eventos.some(ev => ev.status !== 'cancelled' && ev.transparency !== 'transparent' && !(ignorar && ev.id === 'atend' + ignorar));\n} catch (e) {}\n\nlet motivo = null;\nif (c.bloqueado) motivo = 'Bloqueado na agenda';\nelse if (c.conflita) motivo = 'Já existe atendimento nesse horário';\nelse if (ocupadoGoogle) motivo = 'Ocupado no Google Calendar';\n\nreturn [{ json: { disponivel: !c.bloqueado && !c.conflita && !ocupadoGoogle, motivo } }];"
      }
    },
