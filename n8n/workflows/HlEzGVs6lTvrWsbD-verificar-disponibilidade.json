    {
      "id": "19c13ba7-8634-4adb-8bf9-31d435c90bcc",
      "name": "Confere bloqueios e conflitos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const entrada = $('Recebe horário a verificar').first().json;\nconst bloqueios = $('Busca bloqueios').all().map(i => i.json).filter(b => b.tipo);\nconst atendimentos = $input.all().map(i => i.json).filter(a => a.horario);\n\nconst min = (h) => { if (!h) return null; const [hh, mm] = String(h).split(':').map(Number); return hh * 60 + mm; };\nconst reqIni = min(entrada.horario_inicio);\nconst reqFim = min(entrada.horario_fim);\n\nfunction aplica(b) {\n  if (b.id_prof && String(b.id_prof) !== String(entrada.id_prof)) return false;\n  if (b.tipo === 'unico') return b.data_inicio === entrada.data;\n  if (b.tipo === 'periodo') return entrada.data >= b.data_inicio && entrada.data <= b.data_fim;\n  if (b.tipo === 'recorrente') return new Date(entrada.data + 'T12:00:00').getDay() === Number(b.dia_semana);\n  return false;\n}\nfunction conflitaBloqueio(b) {\n  if (!b.horario_inicio || !b.horario_fim) return true;\n  return reqIni < min(b.horario_fim) && reqFim > min(b.horario_inicio);\n}\n\nconst bloqueado = bloqueios.some(b => aplica(b) && conflitaBloqueio(b));\nconst conflita = atendimentos.some(a => {\n  const ini = min(a.horario);\n  const fim = ini + (Number(a.duracao_atend) || 30);\n  return reqIni < fim && reqFim > ini;\n});\n\nreturn [{ json: { bloqueado, conflita, livre: !bloqueado && !conflita } }];"
      }
    },
