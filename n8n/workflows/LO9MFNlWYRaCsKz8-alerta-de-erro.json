      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "inst",
              "name": "email_alertas",
              "type": "string",
              "value": "thorfj1508@gmail.com"
            },
            {
              "id": "num",
              "name": "remetente",
