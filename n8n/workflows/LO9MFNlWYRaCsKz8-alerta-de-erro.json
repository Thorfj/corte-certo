            },
            {
              "id": "no",
              "name": "no",
              "value": "={{ $json.execution?.lastNodeExecuted || $json.execution?.error?.node?.name || \"\" }}",
              "type": "string"
            },
            {
              "id": "msg",
              "name": "mensagem",
              "value": "={{ String($json.execution?.error?.message || $json.trigger?.error?.message || \"Erro sem mensagem\").slice(0, 500) }}",
              "type": "string"
            },
            {
              "id": "url",
              "name": "execucao_url",
              "value": "={{ $json.execution?.url || \"\" }}",
              "type": "string"
            },
            {
              "id": "modo",
