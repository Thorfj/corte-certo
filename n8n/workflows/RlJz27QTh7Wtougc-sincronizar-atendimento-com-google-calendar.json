    {
      "id": "9cac84a6-4fbe-40b8-9ae9-662727601f77",
      "name": "Monta corpo do evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ZONA = 'America/Sao_Paulo';\n// Dados relidos do banco: se dois disparos chegam juntos, os dois usam o estado mais recente\nconst r = $('Busca atendimento atual').first().json;\nconst eventId = $('Analisa mudança').first().json.event_id;\nconst prof = $('Busca Calendar ID novo').first().json || {};\nconst cliente = $input.first().json || {};\nconst inicio = DateTime.fromISO(r.data_agend + 'T' + String(r.horario).slice(0, 8), { zone: ZONA });\nconst fim = inicio.plus({ minutes: Number(r.duracao_atend) || 30 });\n\n// Sem agenda própria do profissional, o evento vai para a agenda principal da conta Google da barbearia\nconst calendarId = prof.agendas || 'primary';\nconst partes = [prof.nome, cliente.nome].filter(Boolean);\n\nconst evento = {\n  id: eventId,\n  status: 'confirmed',\n  summary: partes.length ? partes.join(' — ') : 'Atendimento agendado',\n  description: 'Criado automaticamente pelo Barbozap' + (prof.nome ? '\\nProfissional: ' + prof.nome : '') + (cliente.nome ? '\\nCliente: ' + cliente.nome : '') + (cliente.telefone ? '\\nTelefone: ' + cliente.telefone : ''),\n  start: { dateTime: inicio.toISO({ suppressMilliseconds: true }), timeZone: ZONA },\n  end: { dateTime: fim.toISO({ suppressMilliseconds: true }), timeZone: ZONA },\n  extendedProperties: { private: { corte_certo_atendimento_id: String(r.id) } }\n};\n\nreturn [{ json: { evento, calendarId, eventId } }];"
      }
    },
