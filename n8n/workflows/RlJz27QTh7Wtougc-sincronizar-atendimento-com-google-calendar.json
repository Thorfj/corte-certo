    {
      "id": "f67af2b7-1356-4b96-b89c-37c3052295f4",
      "name": "Analisa mudança",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || {};\nconst tipo = b.type;\nconst rec = b.record || null;\nconst old = b.old_record || null;\nconst campos = ['data_agend', 'horario', 'id_prof', 'duracao_atend'];\n\n// Só reage a mudanças de data/horário/profissional/duração. Isso evita loop quando\n// o próprio n8n grava google_event_id ou os flags de lembrete.\nconst mudou = tipo === 'UPDATE' && rec && old && campos.some(k => String(rec[k]) !== String(old[k]));\n\n// ID fixo do evento no Google (letras a-v e dígitos): disparos simultâneos não duplicam o evento\nconst atendimento_id = (rec || old).id;\nconst event_id = 'atend' + atendimento_id;\nconst trocouProf = Boolean(rec && old && String(rec.id_prof) !== String(old.id_prof));\nconst legado = Boolean(old && old.google_event_id && old.google_event_id !== event_id);\n\nconst apagar = Boolean(old && (tipo === 'DELETE' || (mudou && (trocouProf || legado))));\nconst criar = Boolean(rec && rec.data_agend && rec.horario && rec.id_prof && (tipo === 'INSERT' || mudou));\n\nif (!apagar && !criar) return [];\nreturn [{ json: { tipo, apagar, criar, atendimento_id, event_id, barbearia_id: (rec || old).barbearia_id, old_prof: old ? old.id_prof : null, old_event: old ? (old.google_event_id || event_id) : null, rec } }];"
      }
    },
