    {
      "id": "a7c3bc09-057a-4c43-9377-36488b0e32e3",
      "name": "Calcula horários livres e escolha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Horário de funcionamento vem de barbearias.horario_funcionamento (CRM > Configurações):\n// { \"0\": null, \"1\": [\"09:00\",\"19:00\"], ... } com 0 = domingo ... 6 = sábado e null = fechado.\n// Folgas e feriados continuam vindo dos bloqueios da agenda.\nconst HORARIO_PADRAO = { 0: null, 1: ['09:00', '19:00'], 2: ['09:00', '19:00'], 3: ['09:00', '19:00'], 4: ['09:00', '19:00'], 5: ['09:00', '19:00'], 6: ['09:00', '19:00'] };\nconst PASSO_MIN = 30;\nconst ANTECEDENCIA_MIN = 30;\n\nconst e = $('Entrada da etapa').first().json;\nconst s = e.sessao || {};\n// Remarcação: o horário antigo do próprio cliente não conta como ocupado\nconst remarcarId = s.id_atend_alvo ? Number(s.id_atend_alvo) : null;\nconst servicos = $('Busca serviços selecionados').all().map(i => i.json).filter(x => x.id);\nconst profs = $('Busca profissionais').all().map(i => i.json).filter(x => x.id);\nconst horarioBarbearia = ($('Busca horário da barbearia').first().json || {}).horario_funcionamento || HORARIO_PADRAO;\nconst atends = $('Busca atendimentos do dia').all().map(i => i.json).filter(x => x.horario && Number(x.id) !== remarcarId);\nconst bloqs = $input.all().map(i => i.json).filter(x => x.tipo);\n\nconst min = (h) => { const [hh, mm] = String(h).split(':').map(Number); return hh * 60 + (mm || 0); };\nconst hhmm = (m) => String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');\n\nconst data = s.dia_selecionado;\nconst duracao = servicos.reduce((t, x) => t + (Number(x.duracao_min) || 0), 0) || 30;\nconst candidatos = s.id_prof_selecionado ? profs.filter(p => String(p.id) === String(s.id_prof_selecionado)) : profs;\nconst agora = DateTime.now().setZone('America/Sao_Paulo');\nconst hoje = agora.toFormat('yyyy-MM-dd');\nconst diaSemana = data ? DateTime.fromISO(data, { zone: 'America/Sao_Paulo' }).weekday % 7 : null;\nconst faixa = diaSemana === null ? null : (horarioBarbearia[String(diaSemana)] ?? horarioBarbearia[diaSemana] ?? null);\nconst aberto = Array.isArray(faixa) && faixa.length === 2;\nconst ABERTURA = aberto ? faixa[0] : null;\nconst FECHAMENTO = aberto ? faixa[1] : null;\n\nfunction aplica(b, idProf) {\n  if (b.id_prof && String(b.id_prof) !== String(idProf)) return false;\n  if (b.tipo === 'unico') return b.data_inicio === data;\n  if (b.tipo === 'periodo') return data >= b.data_inicio && data <= b.data_fim;\n  if (b.tipo === 'recorrente') return Number(b.dia_semana) === diaSemana;\n  return false;\n}\nfunction bateBloqueio(b, ini, fim) {\n  if (!b.horario_inicio || !b.horario_fim) return true;\n  return ini < min(b.horario_fim) && fim > min(b.horario_inicio);\n}\nfunction bateAtendimento(a, idProf, ini, fim) {\n  if (String(a.id_prof) !== String(idProf)) return false;\n  const aIni = min(a.horario);\n  const aFim = aIni + (Number(a.duracao_atend) || 30);\n  return ini < aFim && fim > aIni;\n}\n\nconst slots = [];\nif (data && aberto) {\n  for (let t = min(ABERTURA); t + duracao <= min(FECHAMENTO); t += PASSO_MIN) {\n    if (data === hoje && t < agora.hour * 60 + agora.minute + ANTECEDENCIA_MIN) continue;\n    const fim = t + duracao;\n    const livre = candidatos.find(p => !bloqs.some(b => aplica(b, p.id) && bateBloqueio(b, t, fim)) && !atends.some(a => bateAtendimento(a, p.id, t, fim)));\n    if (livre) slots.push({ horario: hhmm(t), fim: hhmm(fim), id_prof: livre.id, nome_prof: livre.nome });\n  }\n}\n\n// Lista sem números de opção (o cliente responde com o próprio horário),\n// separada por período para ficar fácil de ler no WhatsApp\nconst PERIODOS = [['Manhã', 0, 720], ['Tarde', 720, 1080], ['Noite', 1080, 1440]];\nconst lista = PERIODOS.map(([nome, ini, fim]) => {\n  const hs = slots.filter(x => min(x.horario) >= ini && min(x.horario) < fim).map(x => x.horario);\n  return hs.length ? '*' + nome + ':* ' + hs.join(', ') : null;\n}).filter(Boolean).join('\\n');\n\n// Entende \"13\", \"13h\", \"13:30\", \"13h30\", \"1330\", \"às 13\", \"meio-dia\", \"9 e meia\";\n// \"2\" ou \"às 2\" vira 14:00 quando 02:00 não existe\nfunction horariosPedidos(texto) {\n  const t = String(texto || '').trim().toLowerCase().replace(/meio[\\s-]?dia/, '12:00');\n  let h = null, mm = 0, r;\n  if ((r = t.match(/(\\d{1,2})\\s*(?::|h|hs|horas?)\\s*(\\d{2})?/))) { h = Number(r[1]); mm = Number(r[2] || 0); }\n  else if ((r = t.match(/^\\D*(\\d{2})(\\d{2})\\D*$/))) { h = Number(r[1]); mm = Number(r[2]); }\n  else if ((r = t.match(/^\\D{0,5}(\\d{1,2})\\D*$/))) { h = Number(r[1]); }\n  if (h === null) return [];\n  if (!mm && /e meia/.test(t)) mm = 30;\n  if (h > 23 || mm > 59) return [];\n  const opcoes = [h * 60 + mm];\n  if (h >= 1 && h <= 7) opcoes.push((h + 12) * 60 + mm);\n  return opcoes.map(hhmm);\n}\n\nconst pedidos = horariosPedidos(e.mensagem_texto);\nlet escolha = null;\nfor (const alvo of pedidos) {\n  escolha = slots.find(x => x.horario === alvo) || null;\n  if (escolha) break;\n}\n\nreturn [{ json: {\n  aguardando: Boolean(s.aguardando_resposta),\n  tem_horarios: slots.length > 0,\n  fechado: Boolean(data) && !aberto,\n  slots,\n  lista,\n  data,\n  data_br: data ? DateTime.fromISO(data).toFormat('dd/MM') : '',\n  duracao,\n  servicos,\n  resumo_servicos: servicos.map(x => x.nome).join(', '),\n  escolha,\n  escolha_valida: Boolean(escolha),\n  // respondeu um horário, mas ele não está na lista (ocupado ou fora do expediente)\n  pediu_horario_indisponivel: !escolha && pedidos.length > 0,\n  remarcar_id: remarcarId\n} }];"
      }
    },
