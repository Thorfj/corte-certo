    {
      "id": "9e2e41fa-0aac-46af-b3b8-928632c413c0",
      "name": "Monta menu e interpreta escolha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e = $('Entrada da etapa').first().json;\nconst s = e.sessao || {};\nconst profs = $input.all().map(i => i.json).filter(p => p.id);\nconst aguardando = Boolean(s.aguardando_resposta);\nconst menu = profs.map((p, i) => (i + 1) + '. ' + p.nome).join('\\n') + '\\n' + (profs.length + 1) + '. Não tenho preferência';\n\nlet avancar = false;\nlet id_prof = null;\n\nif (profs.length === 1) {\n  avancar = true;\n  id_prof = profs[0].id;\n} else if (aguardando) {\n  const txt = String(e.mensagem_texto || '').trim().toLowerCase();\n  const n = Number((txt.match(/\\d+/) || [])[0]);\n  if (n >= 1 && n <= profs.length) { avancar = true; id_prof = profs[n - 1].id; }\n  else if (n === profs.length + 1 || /prefer|tanto faz|qualquer/.test(txt)) { avancar = true; id_prof = null; }\n  else {\n    const porNome = profs.find(p => txt && p.nome.toLowerCase().includes(txt));\n    if (porNome) { avancar = true; id_prof = porNome.id; }\n  }\n}\n\nreturn [{ json: { aguardando, avancar, id_prof, menu } }];"
      }
    },
