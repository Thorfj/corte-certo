    {
      "id": "f3e193c1-8d59-4594-9bff-50a577fdc502",
      "name": "Normaliza parâmetros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $('Nova safra').first().json;\nconst pega = (chave, rotulo) => (f[chave] !== undefined ? f[chave] : f[rotulo]);\nconst tipo = String(pega('tipo', 'Tipo de safra') || '').startsWith('Follow') ? 'followup' : 'novos';\nconst limite = Math.min(Math.max(parseInt(pega('quantidade', 'Quantidade de leads (máx. 30)'), 10) || 15, 1), 30);\nconst bairro = tipo === 'novos' ? String(pega('bairro', 'Bairro (opcional, só para primeiro contato)') || '').trim() : '';\nconst instancia = String(pega('instancia', 'Instância do WhatsApp (Evolution)') || '').trim();\nconst meuNome = String(pega('meu_nome', 'Seu nome (vai na mensagem)') || '').trim().split(' ')[0];\nconst hoje = DateTime.now().setZone('America/Sao_Paulo').toISODate();\nconst base = 'https://jzqiqrymqbzullysukja.supabase.co/rest/v1/leads?select=*&limit=' + limite;\nlet url;\nif (tipo === 'novos') {\n  url = base + '&status=eq.novo_lead&telefone=not.is.null'\n    + '&or=' + encodeURIComponent('(proximo_passo.is.null,proximo_passo.neq.\"Na fila do n8n\")')\n    + (bairro ? '&bairro=eq.' + encodeURIComponent(bairro) : '')\n    + '&order=tipo_telefone.asc,criado_em.asc';\n} else {\n  url = base + '&status=eq.contato_feito&data_proximo_passo=lte.' + hoje\n    + '&proximo_passo=in.' + encodeURIComponent('(\"Follow-up dia 3\",\"Follow-up dia 7\")')\n    + '&order=data_proximo_passo.asc';\n}\nreturn [{ json: { safra_id: $input.first().json.id, tipo, limite, bairro, instancia, meuNome, hoje, url } }];"
      }
    },
