    {
      "id": "1f455931-f3c1-4130-8938-b1ac159da56a",
      "name": "Monta safra",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Normaliza parâmetros').first().json;\nconst leads = $('Busca leads da safra').all().map(i => i.json).filter(l => l && l.id);\nconst roteiros = $input.all().map(i => i.json).filter(r => r && r.id).sort((a, b) => a.ordem - b.ordem);\nconst etapas = ['novo_lead', 'contato_feito', 'respondeu', 'demo_agendada', 'teste_gratis', 'fechado_ganho', 'perdido'];\nconst primeiros = roteiros.filter(r => /primeiro contato/i.test(r.etapa));\nconst fu3 = roteiros.find(r => /dia 3/i.test(r.etapa));\nconst fu7 = roteiros.find(r => /dia 7/i.test(r.etapa));\nconst somaDias = (n) => DateTime.now().setZone('America/Sao_Paulo').plus({ days: n }).toISODate();\nconst esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// mesmas regras do CRM (core/js/central.js > preencherMensagem)\nconst preencher = (texto, lead) => {\n  let t = texto;\n  const contato = String(lead.nome_contato || '').trim();\n  if (!contato) t = t.replace(/,?\\s*\\[nome\\]/g, '');\n  const bairro = String(lead.bairro || '').split('/')[0].replace(/\\s*\\(.*?\\)/g, '').trim();\n  return t.split('[nome]').join(contato)\n    .split('[barbearia]').join(lead.nome_barbearia || 'sua barbearia')\n    .split('[bairro]').join(bairro || 'região')\n    .split('[seu nome]').join(p.meuNome || '[seu nome]')\n    .split('[Google/Instagram]').join(lead.instagram ? 'Instagram' : 'Google');\n};\nconst itens = [];\nconst semRoteiro = [];\nleads.forEach((lead, i) => {\n  const r = p.tipo === 'novos'\n    ? (primeiros.length ? primeiros[i % primeiros.length] : null)\n    : (/dia 7/i.test(lead.proximo_passo || '') ? fu7 : fu3);\n  if (!r) { semRoteiro.push(lead.nome_barbearia); return; }\n  const update = {};\n  if (r.status_depois && etapas.indexOf(r.status_depois) > etapas.indexOf(lead.status)) update.status = r.status_depois;\n  if (r.dias_proximo_passo !== null && r.dias_proximo_passo !== undefined) {\n    update.proximo_passo = r.proximo_passo;\n    update.data_proximo_passo = somaDias(r.dias_proximo_passo);\n  }\n  itens.push({\n    id: lead.id, nome: lead.nome_barbearia, bairro: lead.bairro, telefone: lead.telefone,\n    tipo_telefone: lead.tipo_telefone, ultimo_contato: lead.ultimo_contato,\n    proximo_original: lead.proximo_passo, data_original: lead.data_proximo_passo,\n    roteiro: r.etapa, texto: preencher(r.texto, lead), update\n  });\n});\nconst titulo = p.tipo === 'novos' ? 'Primeiro contato' : 'Follow-ups do dia';\nconst linhas = itens.map(l => '<li><b>' + esc(l.nome) + '</b> · ' + esc(l.bairro) + ' · ' + esc(l.tipo_telefone)\n  + '<br><small>' + esc(l.roteiro) + '</small><br><i>' + esc(l.texto) + '</i></li>').join('');\nconst aviso = semRoteiro.length ? '<p>Sem roteiro (ficam de fora): ' + esc(semRoteiro.join(', ')) + '</p>' : '';\nconst preview = itens.length\n  ? '<p>' + titulo + ': <b>' + itens.length + ' leads</b> pela instância <b>' + esc(p.instancia) + '</b>.'\n    + ' Entre um envio e outro o fluxo espera de 3 a 7 minutos (cerca de ' + (itens.length * 5) + ' min no total).</p>'\n    + aviso + '<ol>' + linhas + '</ol>'\n  : '<p>Nenhum lead encontrado para essa safra.</p>' + aviso;\nreturn [{ json: { total: itens.length, leads: itens, preview } }];"
      }
    },
