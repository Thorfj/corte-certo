    {
      "id": "66ad6443-2e28-4d5d-9c32-ec865073843a",
      "name": "Interpreta o dia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const MAX_DIAS = 60;\nconst e = $('Entrada da etapa').first().json;\nconst s = e.sessao || {};\nconst txt = String(e.mensagem_texto || '').trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst hoje = DateTime.now().setZone('America/Sao_Paulo').startOf('day');\nconst semana = { domingo: 7, segunda: 1, terca: 2, quarta: 3, quinta: 4, sexta: 5, sabado: 6 };\n\nlet d = null;\nif (/depois de amanha/.test(txt)) d = hoje.plus({ days: 2 });\nelse if (/\\bamanha\\b/.test(txt)) d = hoje.plus({ days: 1 });\nelse if (/\\bhoje\\b/.test(txt)) d = hoje;\nelse {\n  const m = txt.match(/(\\d{1,2})\\s*[\\/\\-.]\\s*(\\d{1,2})(?:\\s*[\\/\\-.]\\s*(\\d{2,4}))?/);\n  if (m) {\n    const ano = m[3] ? Number(m[3].length === 2 ? '20' + m[3] : m[3]) : hoje.year;\n    d = DateTime.fromObject({ year: ano, month: Number(m[2]), day: Number(m[1]) }, { zone: 'America/Sao_Paulo' });\n    if (!m[3] && d.isValid && d < hoje) d = d.plus({ years: 1 });\n  } else {\n    const nome = Object.keys(semana).find(k => txt.includes(k));\n    if (nome) d = hoje.plus({ days: (semana[nome] - hoje.weekday + 7) % 7 });\n  }\n}\n\nconst valido = Boolean(d && d.isValid && d >= hoje && d <= hoje.plus({ days: MAX_DIAS }));\nreturn [{ json: { aguardando: Boolean(s.aguardando_resposta), valido, dia: valido ? d.toFormat('yyyy-MM-dd') : null } }];"
      }
    },
