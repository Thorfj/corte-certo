    {
      "id": "5e5a42a7-61bd-41f9-a519-6aca1b7dd381",
      "name": "Calcula início do follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ZONA = 'America/Sao_Paulo';\nconst ontem = DateTime.now().setZone(ZONA).minus({ days: 1 }).toFormat('yyyy-MM-dd');\nconst atends = $('Busca atendimentos de ontem').all().map(i => i.json).filter(a => a.id_cliente);\nconst prazos = $input.all().map(i => i.json).filter(p => p.id_msg != null);\n\nconst vistos = new Set();\nconst saida = [];\nfor (const a of atends) {\n  if (vistos.has(a.id_cliente)) continue;\n  vistos.add(a.id_cliente);\n  const c = a.clientes || {};\n  if (['follow-up', 'perdido', 'falar_com_humano'].includes(c.status)) continue;\n\n  const recs = (a.atendimento_servicos || []).map(s => s.servicos && s.servicos.recorrencia).filter(Boolean).map(Number);\n  const recorrencia = recs.length ? Math.min(...recs) : 30;\n  const p = prazos.find(x => String(x.barbearia_id) === String(a.barbearia_id) && Number(x.id_msg) === 1);\n  const prazo = Number(p && p.prazo_flu) || 1;\n  const base = DateTime.fromISO(c.data_ult_agend || ontem, { zone: ZONA });\n\n  saida.push({ json: { id_cliente: a.id_cliente, body: {\n    status: 'follow-up',\n    ciclo_followup_atual: 0,\n    recorrencia_followup: recorrencia,\n    data_proximo_followup: base.plus({ days: Math.round(prazo * recorrencia) }).toFormat('yyyy-MM-dd')\n  } } });\n}\nreturn saida;"
      }
    },
