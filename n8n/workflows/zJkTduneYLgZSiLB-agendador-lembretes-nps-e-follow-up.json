    {
      "id": "bce94896-b075-48f5-96bd-e94e305ffc04",
      "name": "Calcula ciclo do follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ZONA = 'America/Sao_Paulo';\nconst hoje = DateTime.now().setZone(ZONA).startOf('day');\nconst clientes = $('Busca clientes com follow-up hoje').all().map(i => i.json).filter(c => c.id);\nconst prazos = $('Busca prazos (ciclo)').all().map(i => i.json).filter(p => p.id_msg != null);\nconst msgs = $('Busca mensagens de follow-up').all().map(i => i.json).filter(m => m.mensagem && !/^\\s*\\[/.test(m.mensagem));\n// Só barbearias com o fluxo ligado (vem filtrado em \"Busca instâncias (follow-up)\")\nconst barbs = $input.all().map(i => i.json).filter(b => b.id);\n\nconst saida = [];\nfor (const c of clientes) {\n  const inst = (barbs.find(b => String(b.id) === String(c.barbearia_id)) || {}).whatsapp_barbearia;\n  // Fluxo desligado (teste acabou, bloqueada ou o dono desligou): pausa o follow-up\n  // sem avançar o ciclo; quando religar, o cliente continua de onde parou.\n  if (!inst) continue;\n\n  const pb = prazos.filter(p => String(p.barbearia_id) === String(c.barbearia_id)).sort((a, b) => Number(a.id_msg) - Number(b.id_msg));\n  const total = pb.length;\n  const prox = (Number(c.ciclo_followup_atual) || 0) + 1;\n\n  if (prox > total) {\n    saida.push({ json: { id_cliente: c.id, patch: { status: 'perdido', data_proximo_followup: null }, enviar: false } });\n    continue;\n  }\n\n  const msg = (msgs.find(m => String(m.barbearia_id) === String(c.barbearia_id) && Number(m.id_msg) === prox) || {}).mensagem;\n\n  // Próxima data: prazo do ciclo seguinte x recorrência. No último ciclo, volta em 7 dias para marcar como perdido.\n  let proxData = hoje.plus({ days: 7 });\n  if (prox < total && c.data_ult_agend && c.recorrencia_followup) {\n    const seguinte = pb.find(p => Number(p.id_msg) === prox + 1);\n    if (seguinte && seguinte.prazo_flu) {\n      proxData = DateTime.fromISO(c.data_ult_agend, { zone: ZONA }).plus({ days: Math.round(Number(seguinte.prazo_flu) * Number(c.recorrencia_followup)) });\n    }\n  }\n  if (proxData <= hoje) proxData = hoje.plus({ days: 1 });\n\n  const nome = String(c.nome || '').split(' ')[0];\n  saida.push({ json: {\n    id_cliente: c.id,\n    patch: { ciclo_followup_atual: prox, data_proximo_followup: proxData.toFormat('yyyy-MM-dd') },\n    enviar: Boolean(msg && c.telefone),\n    instancia: inst,\n    numero: c.telefone || '',\n    texto: String(msg || '').replace(/\\{\\{?\\s*nome\\s*\\}?\\}/gi, nome)\n  } });\n}\nreturn saida;"
      }
    },
