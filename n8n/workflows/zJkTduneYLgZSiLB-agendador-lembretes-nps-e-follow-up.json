    {
      "id": "7db078ae-068c-4d91-9d21-cfc749628239",
      "name": "Monta lembretes e NPS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ZONA = 'America/Sao_Paulo';\n// Textos usados quando a barbearia não preencheu a mensagem em Mensagens > Fluxo.\nconst PADRAO = {\n  'Aviso um dia antes': 'Oi {nome}! Passando para lembrar do seu horário amanhã ({data}) às {horario}. Até lá! 💈',\n  'Aviso uma hora antes': 'Oi {nome}! Seu horário é daqui a pouco, às {horario}. Te esperamos! 💈',\n  // A resposta (1 a 5, mesma escala do CRM) é salva pelo Roteador em atendimentos.nps\n  'NPS atendimento': 'Oi {nome}! Obrigado pela visita hoje 🙏\\nDe 1 a 5, que nota você dá para o seu atendimento? Responda só com o número.'\n};\nconst agora = DateTime.now().setZone(ZONA);\nconst atends = $('Busca atendimentos próximos').all().map(i => i.json).filter(a => a.id);\n// Mensagens ainda com o texto-modelo \"[Escreva aqui...]\" contam como não preenchidas\nconst msgs = $('Busca mensagens de lembrete').all().map(i => i.json).filter(m => m.mensagem && !/^\\s*\\[/.test(m.mensagem));\nconst barbs = $input.all().map(i => i.json).filter(b => b.id);\n\nconst mensagem = (barb, etapa) => (msgs.find(m => String(m.barbearia_id) === String(barb) && m.etapa === etapa) || {}).mensagem || PADRAO[etapa];\nconst instancia = (barb) => (barbs.find(b => String(b.id) === String(barb)) || {}).whatsapp_barbearia;\n\nconst saida = [];\nfor (const a of atends) {\n  const tel = a.clientes && a.clientes.telefone;\n  const inst = instancia(a.barbearia_id);\n  if (!tel || !inst || !a.horario) continue;\n\n  const inicio = DateTime.fromISO(a.data_agend + 'T' + String(a.horario).slice(0, 8), { zone: ZONA });\n  const fim = inicio.plus({ minutes: Number(a.duracao_atend) || 30 });\n  const ate = inicio.diff(agora, 'minutes').minutes;\n  const desde = agora.diff(fim, 'minutes').minutes;\n  const nome = String((a.clientes && a.clientes.nome) || '').split(' ')[0];\n  const preenche = (t) => t\n    .replace(/\\{\\{?\\s*nome\\s*\\}?\\}/gi, nome)\n    .replace(/\\{\\{?\\s*(horario|hora)\\s*\\}?\\}/gi, inicio.toFormat('HH:mm'))\n    .replace(/\\{\\{?\\s*data\\s*\\}?\\}/gi, inicio.toFormat('dd/MM'))\n    .replace(/Oi !/g, 'Oi!');\n  const adiciona = (campo, etapa) => {\n    const m = mensagem(a.barbearia_id, etapa);\n    if (m) saida.push({ json: { id_atend: a.id, campo, instancia: inst, numero: tel, texto: preenche(m) } });\n  };\n\n  if (!a.aviso_1dia_enviado && ate >= 23 * 60 && ate <= 25 * 60) adiciona('aviso_1dia_enviado', 'Aviso um dia antes');\n  if (!a.aviso_1hora_enviado && ate >= 45 && ate <= 75) adiciona('aviso_1hora_enviado', 'Aviso uma hora antes');\n  if (a.compareceu === true && !a.nps_solicitado && desde >= 60 && desde <= 180) adiciona('nps_solicitado', 'NPS atendimento');\n}\n\nreturn saida;"
      }
    },
